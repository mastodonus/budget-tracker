<div id="<%= dom_id user %>">
  <div>
    <strong>Oauth:</strong>
    <%= user.oauth_id %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= user.email %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= user.name %>
  </div>

  <div>
    <strong>Picture:</strong>
    <%= user.picture %>
  </div>

</div>
